# Copiar este archivo como .env (en la carpeta backend/) y completar los valores vacíos.
# El .env nunca se versiona. Los secretos se comparten solo por el gestor de contraseñas del equipo.

# --- Base de datos compartida (MonsterASP) ---
# Copiar la contraseña exacta: varios intentos fallidos bloquean tu IP 24 h.
DB_SERVER=db81318.public.databaseasp.net
DB_NAME=db81318
DB_USER=db81318
DB_PASSWORD=

# --- Firma de los tokens JWT (obligatoria, mínimo 32 caracteres) ---
# Cada integrante puede generar la suya; solo vale para su API local. Generarla en PowerShell con:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_KEY=

# --- Opcional: contraseña temporal del administrador inicial ---
# Solo se usa si la BD aún tiene el marcador del script (primera instalación). Mínimo 8 caracteres.
# ADMIN_PASSWORD=
